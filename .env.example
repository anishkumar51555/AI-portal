# ─────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in the blanks. NEVER commit .env.local.
# Every variable here is validated at boot by src/lib/env.ts — a missing
# or malformed value crashes the process in ~50ms with a clear message
# rather than producing a mysterious 500 three days later.
# Reference: docs/05-infrastructure.md section 2.3
# ─────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────
# Matches docker-compose.yml. In production use Neon's POOLED url here
# and the DIRECT url for `prisma migrate deploy`.
DATABASE_URL="postgresql://portal:portal_dev_password@localhost:5432/ai_portal?schema=public"

# ── Auth.js ──────────────────────────────────────────────────────────
# Generate with: npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Required behind any proxy, including Vercel. Callbacks fail without it.
AUTH_TRUST_HOST=true

# Create at https://github.com/settings/developers
#   Homepage URL:  http://localhost:3000
#   Callback URL:  http://localhost:3000/api/auth/callback/github
# Use a SEPARATE OAuth app for production — one app cannot serve two callback URLs.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Object storage (S3-compatible) ───────────────────────────────────
# MinIO locally, Cloudflare R2 in production. Same SDK, same code path.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-portal
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style addressing; R2 and AWS S3 do not. Getting this
# wrong produces 403s and DNS errors on every call.
S3_FORCE_PATH_STYLE=true
# What the BROWSER should hit for presigned URLs. Differs from S3_ENDPOINT
# when the app reaches storage over an internal network name.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ── Upload limits ────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760          # 10 MB compressed
MAX_UNCOMPRESSED_BYTES=52428800    # 50 MB expanded — zip-bomb guard
MAX_ARCHIVE_ENTRIES=1000           # entry-flood guard
MAX_COMPRESSION_RATIO=100          # per-entry ratio guard
PRESIGN_TTL_SECONDS=900
DOWNLOAD_TTL_SECONDS=300

# ── Privacy / ops ────────────────────────────────────────────────────
# Raw IPs are never stored. Downloads record sha256(ip + this salt).
# Generate with: openssl rand -hex 16
DOWNLOAD_IP_SALT=
LOG_LEVEL=debug
