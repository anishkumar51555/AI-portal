# testing
/coverage
/playwright-report
/test-results
/blob-report
/.playwright

# NOTE: tests/fixtures/archives/*.zip is deliberately NOT ignored.
# The hostile-archive corpus is COMMITTED (rules/70-testing.md) so every machine
# and CI run tests the byte-identical inputs. `npm run fixtures:build` regenerates
# them, but a regenerated bomb.zip that differs subtly could pass a guard the
# committed one catches — so the bytes, not the recipe, are the fixture.

# built template archives (rebuilt with `npm run templates:build`)
/templates/.dist/
/templates/**/dist/
/templates/*.zip

# env — .env.example is the only one that is committed
.env
.env.*
!.env.example

# prisma
/prisma/*.db
/prisma/*.db-journal

# logs
*.log
npm-debug.log*
yarn-error.log*

# os / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# typescript
*.tsbuildinfo
