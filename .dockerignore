# Everything the build does not need. Keeps the context small and stops local
# secrets or build output leaking into an image layer.
node_modules
.next
.git
.github
coverage
playwright-report
test-results
.playwright

# NEVER copy real secrets into the build context.
.env
.env.*
!.env.example

# Not needed at build or runtime.
#
# `next build` TYPECHECKS everything the context contains, so anything excluded
# must have nothing left behind that imports it. This has bitten twice:
# scripts/ imports tests/, and playwright.config.ts imports tests/e2e. Excluding
# one without the other fails the image build with a missing-module error that
# never appears locally, because locally the files are all present.
tests
scripts
playwright.config.ts
vitest.config.ts
docs
templates/.dist
*.md
!README.md
.vscode
.idea
Dockerfile
.dockerignore
docker-compose.yml
