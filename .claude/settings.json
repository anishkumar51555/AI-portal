{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm test:*)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma format)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker ps:*)",
      "Read(//e/AI Portal/**)",
      "Grep",
      "Glob",
      "Bash(npx tsc *)",
      "Bash(echo \"exit=$?\")",
      "Bash(npx vitest *)",
      "Bash(node \"C:/Users/anish/AppData/Local/Temp/claude/e--AI-Portal/0b78940d-e39c-4599-824c-4d02800344ed/scratchpad/patch-state-2.mjs\")",
      "Bash(npx prettier *)",
      "Bash(sed -n '/## Next up/,/## Decisions/p' PROJECT-STATE.md)"
    ],
    "deny": [
      "Read(//e/AI Portal/.env)",
      "Read(//e/AI Portal/.env.local)",
      "Read(//e/AI Portal/.env.production)",
      "Read(//e/AI Portal/.env.production.local)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(npm run db:migrate:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(npx prisma db push:*)",
      "Bash(docker compose down:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(vercel:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-sensitive.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.ps1\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-brief.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
